# ─────────────────────────────────────────────────────────────
# Reelpad configuration. Copy to server/.env for local dev.
# On Render, set these in the dashboard (render.yaml lists them).
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=8080
APP_NAME=Reelpad
# Your domain, no trailing slash. Must match the Instagram OAuth redirect URI host.
PUBLIC_URL=https://yourdomain.com

# Postgres 14+
DATABASE_URL=postgres://user:pass@host:5432/reelpad
# true for external/managed connections that require TLS, false for Render's internal URL or local Postgres
DATABASE_SSL=true

# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# 32-byte key encrypting agent wallets, mint keys and Instagram tokens. BACK THIS UP: losing it loses every treasury.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=
# Comma-separated wallets that can open /admin
ADMIN_WALLETS=

# ── Solana ──
# Use a paid RPC (Helius, Triton, QuickNode). The public endpoint rate-limits and drops transactions.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
PLATFORM_FEE_WALLET=YourFeeWalletPubkey
PLATFORM_FEE_SOL=0.02
AGENT_GAS_FUND_SOL=0.01
LAUNCH_PRIORITY_MICROLAMPORTS=200000
PUMPPORTAL_PRIORITY_FEE=0.00005
PUMPPORTAL_SLIPPAGE=15

# ── Token metadata (pump.fun requires IPFS) ──  https://app.pinata.cloud → API keys → JWT
PINATA_JWT=
IPFS_GATEWAY=https://ipfs.io/ipfs

# ── Public media storage (Cloudflare R2 recommended) ──
# Instagram downloads every image/video from a public URL, so the bucket must be publicly readable.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=reelpad-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL for the bucket (R2 custom domain or r2.dev URL)
S3_PUBLIC_BASE_URL=https://media.yourdomain.com

# ── Instagram (Meta app → Instagram → API setup with Instagram login) ──
IG_APP_ID=
IG_APP_SECRET=
IG_API_VERSION=v23.0
# testers = before Meta approval: creators enter their username, you add it as an Instagram Tester
#           (admin page shows the queue), they accept the invite and log in.
# open    = after Meta approval: "Log in with Instagram" works for everyone. No code change needed.
IG_ACCESS_MODE=testers

# ── AI ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
FAL_KEY=
# Image model must accept a reference image (image_url) to keep the character consistent
FAL_IMAGE_MODEL=fal-ai/flux-pro/kontext
FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video
# Cost estimates used for the daily budget (check current fal.ai pricing)
COST_IMAGE_USD=0.04
COST_VIDEO_USD=0.5
COST_LLM_USD=0.02
DAILY_AI_BUDGET_USD=50

# ── Content limits (platform-wide caps; creators choose within these) ──
CONTENT_MAX_POSTS_PER_DAY=3
CONTENT_MAX_REELS_PER_WEEK=3
CAPTION_FOOTER=AI-generated persona. Not financial advice.

# ── Treasury safety ──
# Leave true until you've watched simulated trades for a while. false = real on-chain buys and burns.
TREASURY_DRY_RUN=true
TREASURY_MAX_SOL_PER_ACTION=0.5
TREASURY_MAX_SOL_PER_DAY=2
TREASURY_MIN_INTERVAL_MIN=15
TREASURY_GAS_RESERVE_SOL=0.01

# Run the background worker inside the web process (simplest). Set false if you run `npm run worker` separately.
RUN_WORKER=true
LOG_LEVEL=info

# ── Frontend build-time (Vite) ──
# RPC the browser uses for the optional first buy. Use a key restricted to your domain.
VITE_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_BROWSER_KEY
