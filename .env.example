# ─────────────────────────────────────────────────────────────
# Reelpad configuration. Copy to server/.env for local dev.
# On Render, set these in the dashboard (render.yaml lists them).
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=8080
APP_NAME=Reelpad
# Your domain, no trailing slash. Must match the Instagram OAuth redirect URI host.
PUBLIC_URL=https://yourdomain.com

# Postgres 14+
DATABASE_URL=postgres://user:pass@host:5432/reelpad
# true for external/managed connections that require TLS, false for Render's internal URL or local Postgres
DATABASE_SSL=true

# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# 32-byte key encrypting agent wallets, mint keys and Instagram tokens. BACK THIS UP: losing it loses every treasury.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=
# Comma-separated wallets that can open /admin
ADMIN_WALLETS=

# ── Solana ──
# Use a paid RPC (Helius, Triton, QuickNode). The public endpoint rate-limits and drops transactions.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
PLATFORM_FEE_WALLET=YourFeeWalletPubkey
PLATFORM_FEE_SOL=0.02
AGENT_GAS_FUND_SOL=0.01
LAUNCH_PRIORITY_MICROLAMPORTS=200000
PUMPPORTAL_PRIORITY_FEE=0.00005
PUMPPORTAL_SLIPPAGE=15

# ── Token metadata (pump.fun requires IPFS) ──  https://app.pinata.cloud → API keys → JWT
PINATA_JWT=
IPFS_GATEWAY=https://ipfs.io/ipfs

# ── Public media storage (Cloudflare R2 recommended) ──
# Instagram downloads every image/video from a public URL, so the bucket must be publicly readable.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=reelpad-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL for the bucket (R2 custom domain or r2.dev URL)
S3_PUBLIC_BASE_URL=https://media.yourdomain.com

# ── Instagram (Meta app → Instagram → API setup with Instagram login) ──
IG_APP_ID=
IG_APP_SECRET=
IG_API_VERSION=v23.0
# testers = before Meta approval: creators enter their username, you add it as an Instagram Tester
#           (admin page shows the queue), they accept the invite and log in.
# open    = after Meta approval: "Log in with Instagram" works for everyone. No code change needed.
IG_ACCESS_MODE=testers
# Optional: Facebook App ID (App settings → Basic). Lets Admin link straight to your app's Roles page.
META_APP_ID=

# ── AI ──
# ── Generation quality ──
# premium (default): Nano Banana Pro images, Veo 3.1 Fast talking Reels (6s), Claude Opus 5.5 writing,
#                    and a Claude quality check that redraws images where the character doesn't match.
# standard: FLUX Kontext images, Kling 2.6 Reels (5s), Claude Sonnet 5.5, no check (about 1/3 the cost).
# custom: use the ANTHROPIC_MODEL / FAL_IMAGE_MODEL / FAL_REEL_MODEL / REEL_SECONDS / COST_* / QUALITY_CHECK values below.
GENERATION_TIER=premium
QUALITY_CHECK_MODEL=claude-sonnet-5-5
COST_CHECK_USD=0.01

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Only if your key covers several workspaces (personal keys can); otherwise leave empty.
ANTHROPIC_WORKSPACE_ID=
FAL_KEY=
# Image model must accept a reference image (image_url) to keep the character consistent
FAL_IMAGE_MODEL=fal-ai/flux-pro/kontext
# Reels: a video model with native audio, so the character talks (lip-synced) with sound effects.
# fal-ai/kling-video/v2.6/pro/image-to-video (default, ~$0.14/s with audio) or fal-ai/veo3.1/image-to-video (~$0.40/s)
FAL_REEL_MODEL=fal-ai/kling-video/v2.6/pro/image-to-video
REEL_SECONDS=5          # Kling: 5 or 10. Veo: 4, 6 or 8
REEL_AUDIO=true         # false = silent Reels
# Cost estimates used for the daily budget (check current fal.ai pricing)
COST_IMAGE_USD=0.04
COST_REEL_USD=0.7
COST_LLM_USD=0.02
DAILY_AI_BUDGET_USD=150

# ── Content limits (platform-wide caps; creators choose within these) ──
CONTENT_MIN_POSTS_PER_DAY=12
CONTENT_MAX_POSTS_PER_DAY=24
CONTENT_MAX_REELS_PER_WEEK=21
CAPTION_FOOTER=AI-generated persona. Not financial advice.

# ── Treasury safety ──
# Buybacks and burns are always live on-chain. (The old TREASURY_DRY_RUN setting is ignored.)
# Local testing only: TREASURY_SIMULATION=true logs buybacks without sending them.
# Every buyback spends ALL collected creator fees (no per-buy or daily cap): NATIVE_BUYBACK_SHARE of it
# buys back and burns the platform's native coin, the rest buys back and burns the coin itself.
NATIVE_COIN_MINT=2CZJzBoeS17uAQbAdBcrkpEJjPixEcsFvJAhwRV9pump
NATIVE_BUYBACK_SHARE=0.5
# Graduated coins are bought through Jupiter. Optional key from portal.jup.ag (otherwise the free lite API).
JUPITER_API_KEY=
TREASURY_MIN_INTERVAL_MIN=15      # how often each treasury is checked (fees claimed, price recorded)
TREASURY_BUY_INTERVAL_MIN=60      # minimum minutes between buybacks for one coin
TREASURY_MIN_BUY_SOL=0.01         # wait until this much in fees has collected before buying
TREASURY_GAS_RESERVE_SOL=0.01     # always kept in the agent wallet for fees and rent

# Run the background worker inside the web process (simplest). Set false if you run `npm run worker` separately.
RUN_WORKER=true
LOG_LEVEL=info

# ── Frontend build-time (Vite) ──
# RPC the browser uses for the optional first buy. Use a key restricted to your domain.
VITE_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_BROWSER_KEY
